# Optional runtime overrides for bench.config.json.
# On Netlify, give runtime variables Functions scope.
BENCH_UPSTREAM_ORIGIN=https://www.example.com
BENCH_PUBLIC_ORIGIN=https://staging.example.com
BENCH_PORT=4173

# Required only when server.access.enabled is true.
BENCH_AUTH_USER=bench
BENCH_AUTH_PASSWORD=replace-me
